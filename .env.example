# 是否信任 Cloudflare Zero Trust Access 注入的 Cf-Access-Authenticated-User-Email 请求头
# 仅在仅监听 127.0.0.1 且由 Cloudflare Tunnel + Access 保护 /admin* 与 /api/admin/* 时开启
TRUST_CF_ACCESS=true

# 允许免密进入管理后台的 Cloudflare Access 邮箱白名单（多个用逗号分隔；留空则允许所有通过 Zero Trust 策略的邮箱）
CF_ACCESS_ALLOWED_EMAILS=you@example.com

# 可选：Bearer Token 兜底鉴权密钥（调试或绕过 Zero Trust 使用，不需要可留空）
ADMIN_TOKEN=

# 对外公网访问基址（用于拼接上传图片返回链接，末尾不要加 /）
PUBLIC_BASE_URL=https://notice.buct.one

# 跨域配置（前后端同域部署时保持 * 即可）
CORS_ORIGIN=*
